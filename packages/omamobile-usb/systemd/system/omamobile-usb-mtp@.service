# File transfer over USB (MTP) for one user: umtprd on the gadget's
# FunctionFS, as that user, sharing the folders omamobile-usbd wrote into its
# configuration (the user's Documents, Downloads, Music, Pictures and Videos).
# Started and stopped by omamobile-usbd only; ready once the USB descriptors
# are written, which the gadget needs before it is bound.
[Unit]
Description=USB file transfer (MTP) for %i
ConditionPathExists=/run/omamobile/usb/umtprd.conf

[Service]
Type=notify
NotifyAccess=main
User=%i
ExecStart=/usr/bin/umtprd -conf /run/omamobile/usb/umtprd.conf
TimeoutStartSec=10
TimeoutStopSec=5
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
