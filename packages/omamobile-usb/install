#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-usb into DESTDIR. The system unit and the session's prompt
# are on by vendor wants links, so they start at the next boot and login;
# the package's install script starts neither.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omamobile-usb "$d/usr/bin/omamobile-usb"
install -Dm755 lib/omamobile-usbd "$d/usr/lib/omamobile/omamobile-usbd"
install -Dm755 lib/omamobile-usb-prompt "$d/usr/lib/omamobile/omamobile-usb-prompt"
s=$d/usr/lib/systemd/system u=$d/usr/lib/systemd/user
install -Dm644 systemd/system/omamobile-usb.service "$s/omamobile-usb.service"
install -Dm644 systemd/system/omamobile-usb-mtp@.service "$s/omamobile-usb-mtp@.service"
install -Dm644 systemd/user/omamobile-usb-prompt.service "$u/omamobile-usb-prompt.service"
mkdir -p "$s/multi-user.target.wants" "$u/graphical-session.target.wants"
ln -sfn ../omamobile-usb.service "$s/multi-user.target.wants/omamobile-usb.service"
ln -sfn ../omamobile-usb-prompt.service "$u/graphical-session.target.wants/omamobile-usb-prompt.service"
install -Dm644 etc/omamobile/usb.conf "$d/etc/omamobile/usb.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-usb/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/usb/version"
